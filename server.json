{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ANAMIZED/openmesha",
  "title": "OpenMesha",
  "description": "Open agentic operations mesh with MCP, cost control, governance.",
  "repository": {
    "url": "https://github.com/ANAMIZED/OpenMesha",
    "source": "github"
  },
  "version": "0.1.0",
  "websiteUrl": "https://github.com/ANAMIZED/OpenMesha",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "openmesha",
      "version": "0.1.0",
      "runtimeHint": "uvx",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "OM_LLM_MODE",
          "description": "LLM mode. Use mock for Glama / CI.",
          "isRequired": false,
          "default": "mock",
          "choices": ["mock", "live"]
        },
        {
          "name": "OM_DATA_DIR",
          "description": "Writable data directory.",
          "isRequired": false,
          "default": "./data"
        }
      ]
    }
  ]
}
